# Chronos-Nexus — copy to .env and fill in. NEVER commit .env.
# PAPER TRADING ONLY. Live Bitget keys are rejected by design.

# --- LLM (Bitget hackathon Qwen proxy; QWEN_MODEL falls back to qwen3.8-max) ---
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-max

# --- Bitget Paper Trading (Demo API Key — NOT a live key) ---
# Bitget → switch to Demo mode → API Key Management → Create Demo API Key
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
BITGET_PAPER_TRADING=true
BITGET_SYMBOL=rNVDA/USDT:USDT

# --- Arbitrum Sepolia (chain ID 421614) ---
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_SEPOLIA_CHAIN_ID=421614
# TESTNET wallet only — used for 0-value Proof-of-Thought txs
ARBITRUM_PRIVATE_KEY=

# --- Telegram live alerts (optional; disarmed if empty) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
